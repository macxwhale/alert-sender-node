{
  "name": "alert-sender-node",
  "version": "1.0.0",
  "description": "Node.js port of WaveSphere AlertSenderService. Polls SQL Server for queued Email/SMS alerts and dispatches them through pluggable providers (Beem Africa added).",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "install-service": "node scripts/install-service.js",
    "uninstall-service": "node scripts/uninstall-service.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "mssql": "^11.0.1",
    "nodemailer": "^6.9.14",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "optionalDependencies": {
    "node-windows": "^1.0.0-beta.8"
  },
