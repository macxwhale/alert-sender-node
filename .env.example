# ============================================================================
# AlertSenderService (Node port) configuration
# Mirrors the old AlertSenderService.exe.config <appSettings>/<connectionStrings>
# Copy to ".env" and fill in. Values with CRYPT: prefix are decrypted at load
# using the legacy CryptorEngine (3DES-ECB, MD5-hashed key).
# ============================================================================

# --- Database connections (SQL Server) ---
# Same servers/catalogs as the original app.
ALERT_MODULE_CONN=Server=10.10.10.230\SQLEXPRESSNEW;Database=Alert_Module;User Id=sa;Password=wavetec;Encrypt=false;TrustServerCertificate=true
EQPORTAL_CONN=Server=10.10.10.230\SQLEXPRESSNEW;Database=eqPortal;User Id=sa;Password=wavetec;Encrypt=false;TrustServerCertificate=true

# --- Poll intervals (ms) ---
ServicePollInterval=60000
SMSServicePollInterval=30000

# --- Worker threads (concurrency) ---
NumberOfThreadsForEmail=1
NumberOfThreadsForSMS=10

# --- Toggles ---
SendEmail=true
SendSMS=true

# --- Region filter for email configs (eqPortal) ---
RegionId=0

# --- Legacy crypto key (used to decrypt any CRYPT: value below) ---
CRYPTO_KEY=AB728DB5CEFAE

# --- Logging ---
LogLevel=debug
LogDir=Log

# ============================================================================
# SMS provider selector. Matches original SMSServiceType numbering:
#  1 Clickatell  2 Esendex  3 NSSF  4 KCB  5 SharjahMun  6 Profuturo
#  7 Infobip  8 AMAF  9 DMI  10 UAP  11 SEHA  12 Orange  13 NIBTT
#  14 Nahdi  15 Safaricom(SMPP)  16 RAFID  17 OnfonMedia
#  18 Beem   <-- NEW
# ============================================================================
SMSServiceType=18

# --- Beem Africa (NEW provider) ---
# Base host from the Postman collection. Use the /test/ path while testing.
BEEM_API=https://messaging-service.co.tz/api/sms/v2/text/single
BEEM_API_KEY=your_api_key
BEEM_SECRET_KEY=your_secret_key
BEEM_SOURCE_ADDR=INFO
BEEM_ENCODING=0

# --- ONFON Media (example legacy provider, type 17) ---
ONFONAPI=https://api.onfonmedia.co.ke/v1/sms/SendBulkSMS
ONFONSenderId=Carrefour
ONFONIsUnicode=true
ONFONIsFlash=true
ONFONApiKey=your_onfon_api_key
ONFONClientId=your_onfon_client_id

# --- Email (SMTP) fallback defaults; per-region config is read from eqPortal ---
SMTPServer=smtp.office365.com
SMTPPort=587
EnableSsl=true
EmailUserName=edc.online.qms@edcad.ae
# Encrypted with legacy CryptorEngine; decrypts using CRYPTO_KEY above.
EmailPassword=CRYPT:nkrppafj1bQDsM64gwwxBA==

# --- SMS status codes written back to Alerts.StatusId ---
# Original schema: pending=1. Set these to match your DB.
STATUS_SENT=2
STATUS_FAILED=3
